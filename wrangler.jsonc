{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
      { "name": "METRICS", "class_name": "MetricsDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiterDO", "MetricsDO"] }]
}
